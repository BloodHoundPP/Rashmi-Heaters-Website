# ----------------------------------------------------------------------
# Rashmi Heaters - Hostinger & LiteSpeed Optimization
# Prevents HTTP 429, overrides default.php parking page, enables Caching & Compression
# ----------------------------------------------------------------------

# Prioritize index.html over Hostinger default.php
DirectoryIndex index.html index.php

# 1. Prevent Directory Listing
Options -Indexes

# 2. Enable Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>

# 3. Leverage Browser Caching (Reduces server request burst to prevent 429)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML documents - no-cache so updates are immediately visible
  ExpiresByType text/html "access plus 0 seconds"

  # CSS, JavaScript (Vite uses hashed filenames, safe to cache long term)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"

  # Images and Media
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 year"

  # Web Fonts
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# 4. Set Cache-Control Headers
<IfModule mod_headers.c>
  # HTML - always revalidate
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Static assets with hashed filenames - cache forever (1 year)
  <FilesMatch "\.(css|js|png|jpg|jpeg|gif|webp|svg|ico|woff|woff2|ttf|mp4|pdf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# 5. SPA Routing & 404 Protection (Stops 404 loops from rewriting to index.html)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Override Hostinger's default.php parking page
  RewriteRule ^default\.php$ index.html [L]

  # Allow existing files and directories to be served directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Don't rewrite missing static asset extensions to index.html; return 404 immediately
  RewriteCond %{REQUEST_URI} \.(css|js|png|jpe?g|gif|ico|svg|webp|woff2?|ttf|eot|mp4|pdf|map)$ [NC]
  RewriteRule ^ - [R=404,L]

  # Route all other SPA paths to index.html
  RewriteRule ^ index.html [L]
</IfModule>
